# Copy this file to .env and fill in your local values (.env is gitignored)

VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_ESRI_SATELLITE_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
VITE_OSM_STREET_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

DATABASE_URL=sqlite:///./aecren_evidence.db
AECREN_SECRET_KEY=replace-with-your-hmac-secret-key
PRIVATE_VAULT_DIR=./backend/private_vault

